<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.gridgain</groupId>
    <artifactId>gg8-examples-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>GridGain 8 CE Examples</name>
    <description>Example applications for GridGain 8 Community Edition.</description>
    <url>https://github.com/GridGain-Demos/gg8-examples</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <modules>
        <module>examples</module>
        <module>examples-ml</module>
    </modules>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            This project is NOT a standalone build. It requires the GridGain CE
            sources alongside it (default: a sibling clone at ../gridgain),
            installed into the local Maven repository via `mvn install -DskipTests`.

            The examples' own version tracks CE's version: ${revision} resolves
            from the IGNITE_VERSION environment variable, which must match the
            version produced by that CE install. The bundled helper script (see
            bin/build.sh) reads CE's pom.xml and sets it automatically; pass it
            manually with -Drevision=... otherwise.

            No artifacts are pulled from any public GridGain Maven repository:
            everything comes from your locally-installed CE build.
        -->
        <revision>${env.IGNITE_VERSION}</revision>

        <!-- Third-party versions mirroring the upstream CE parent. -->
        <javax.cache.version>1.0.0</javax.cache.version>
        <javassist.version>3.21.0-GA</javassist.version>

        <!-- Plugin versions. -->
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>

        <!-- Don't deploy examples as Maven artifacts. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- GridGain engine -->
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-spring</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-log4j</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-log4j2</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-indexing</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-spring-data_2.2</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-schedule</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-geospatial</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-hibernate_5.1</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-lucene-9</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-ml</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-ml-xgboost-model-parser</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-ml-spark-model-parser</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-ml-mleap-model-parser</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- GridGain test artifacts -->
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-core</artifactId>
                <version>${revision}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>org.gridgain</groupId>
                <artifactId>ignite-tools</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- Third-party -->
            <dependency>
                <groupId>javax.cache</groupId>
                <artifactId>cache-api</artifactId>
                <version>${javax.cache.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-cli</groupId>
                <artifactId>commons-cli</artifactId>
                <version>1.2</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.simple-spring-memcached</groupId>
                <artifactId>spymemcached</artifactId>
                <version>2.8.4</version>
            </dependency>
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>2.3.1</version>
            </dependency>
            <dependency>
                <groupId>com.sun.xml.bind</groupId>
                <artifactId>jaxb-impl</artifactId>
                <version>2.3.0</version>
            </dependency>
            <dependency>
                <groupId>com.sun.xml.bind</groupId>
                <artifactId>jaxb-core</artifactId>
                <version>2.3.0</version>
            </dependency>
            <dependency>
                <groupId>org.jpmml</groupId>
                <artifactId>pmml-model</artifactId>
                <version>1.4.7</version>
            </dependency>
            <dependency>
                <groupId>org.apache.parquet</groupId>
                <artifactId>parquet-hadoop</artifactId>
                <version>1.10.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-common</artifactId>
                <version>2.9.2</version>
            </dependency>
            <dependency>
                <groupId>org.javassist</groupId>
                <artifactId>javassist</artifactId>
                <version>${javassist.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                    <configuration>
                        <!-- Only run the test suites; individual *SelfTest classes are aggregated by them. -->
                        <includes>
                            <include>**/*Suite.java</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
